# Copie para client/.env se precisar mudar algo.

# Endereço do servidor usado pelo proxy do Vite em desenvolvimento.
DEV_SERVER_PROXY_TARGET=http://localhost:3001

# Em produção, se o servidor estiver em outro domínio, informe a URL aqui.
# Deixe vazio para usar a mesma origem da página.
VITE_SERVER_URL=
