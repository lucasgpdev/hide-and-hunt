# Copie este arquivo para server/.env e ajuste se necessário.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Origens que podem conectar ao servidor (separe várias com vírgula).
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL (o mesmo do docker-compose.yml). Deixe vazio para rodar sem banco.
DATABASE_URL=postgres://hidehunt:hidehunt_dev@localhost:5432/hidehunt

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

MAX_CONNECTIONS=500

# Jogadores necessários para uma sala pública começar sozinha (2 a 32).
PUBLIC_MIN_PLAYERS=2

# Painel de moderação (/#admin e /api/admin/*). Vazio = desativado. Mínimo de 24 caracteres.
ADMIN_TOKEN=

# Produção em um só serviço: pasta do cliente compilado (npm run build). Vazio em desenvolvimento.
CLIENT_DIST=
